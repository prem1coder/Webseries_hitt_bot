# ==============================================================================
# Telegram Video Search & Download Bot - Environment Configuration
# ==============================================================================

# Telegram Bot API (aiogram) - Get from @BotFather
BOT_TOKEN=your_telegram_bot_token

# Telegram MTProto API (Telethon) - Get from https://my.telegram.org
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION_NAME=archive_indexer

# Target Telegram Channels
# Private archive channel containing movies/series (can be username or -100xxxxxxxxxx channel ID)
ARCHIVE_CHANNEL_ID=-100xxxxxxxxxx
# Main public or private channel for mandatory membership verification
MAIN_CHANNEL_ID=-100xxxxxxxxxx
MAIN_CHANNEL_INVITE_LINK=https://t.me/your_channel_invite

# PostgreSQL Database Connection
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/video_bot
# Synchronous DB URL for Alembic or direct tools if needed:
# SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/video_bot

# Security & Web Token Settings
# 32+ character random secret string used to sign download tokens (HMAC-SHA256)
DOWNLOAD_SECRET=generate_a_secure_random_32_character_secret_string
# Download token validity duration in minutes (default: 15)
TOKEN_EXPIRY_MINUTES=15

# Web Server & Domain Configuration
DOMAIN=localhost:8000
WEB_HOST=0.0.0.0
WEB_PORT=8000
USE_HTTPS=false

# Indexer Settings
BATCH_SIZE=100
FLOOD_WAIT_MAX_RETRIES=5
